BOT_TOKEN=your-telegram-bot-token
OPENAI_API_KEY=your-api-key
# Провайдер: для aiprimetech раскомментируйте; для OpenAI оставьте пустым
# OPENAI_BASE_URL=https://aiprimetech.io/v1
CHAT_MODEL=gpt-6-luna
EMBED_MODEL=text-embedding-3-small
# Если провайдер чата не отдаёт эмбеддинги (у aiprimetech группы Codex их нет):
# 1) локальная модель, без API и ключей — данные остаются на вашем компьютере
EMBED_PROVIDER=local
# LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 2) либо другой провайдер (EMBED_PROVIDER=api):
# EMBED_BASE_URL=
# EMBED_API_KEY=
# Необязательно:
# MAX_COMPLETION_TOKENS=1500   # лимит ответа; у reasoning-моделей включает «мысли»
# RAG_MAX_DISTANCE=0.75        # порог релевантности чанков (меньше — строже)
